{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Abrir Chá da Júlia",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/serve.cjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "http://127\\.0\\.0\\.1:([0-9]+)",
        "uriFormat": "http://127.0.0.1:%s",
        "action": "openExternally"
      },
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
